{
  "name": "sakke-gateway",
  "version": "0.1.0",
  "description": "AI Gateway — parses natural language commands and dispatches to Home Assistant",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && find src -name '*.md' -exec sh -c 'for f; do d=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$d\")\"; cp \"$f\" \"$d\"; done' _ {} +",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.3.3",
    "js-logger": "^1.6.1",
    "js-yaml": "^4.1.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
