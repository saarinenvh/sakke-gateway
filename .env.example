# Ollama (main agent - tool calling, conversation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=32768   # KV cache size - lower on VRAM-constrained deployments
# OLLAMA_THINK=false     # omit to use the model's own default

# Follow-up classifier (continuation/new_request/noise) - deliberately
# independent of the main agent's model/endpoint above, so it stays fast and
# local even if the main agent gets routed to a bigger/remote model.
# OLLAMA_CLASSIFIER_BASE_URL=http://localhost:11434
# OLLAMA_CLASSIFIER_MODEL=qwen3:8b

# Optional GPU-routing target (see scripts/gpu-router/ in sakke-workspace) -
# leave unset to always use the OLLAMA_* config above. When set, the main
# agent routes here instead, but only when /internal/gpu-status reports
# state=available; busy/unknown/stale always falls back to OLLAMA_* above.
# PC_OLLAMA_BASE_URL=http://<pc-tailscale-ip>:11434
# PC_OLLAMA_MODEL=qwen3:14b
# PC_OLLAMA_NUM_CTX=32768
# PC_OLLAMA_THINK=false

# The "I'm gaming" / "I'm free" voice override tool reuses PC_OLLAMA_BASE_URL
# above to free VRAM directly via Ollama's own API - no separate endpoint needed.

# Home Assistant
HA_BASE_URL=http://localhost:8123
HA_TOKEN=your_long_lived_access_token_here
HA_CONFIG_PATH=/ha-config
ASSIST_SATELLITE_ENTITY_ID=assist_satellite.sakke_assist_satellite

# Gateway
PORT=3100

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
