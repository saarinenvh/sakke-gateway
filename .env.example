# Local development values, for running the gateway outside Docker on the dev
# machine (WSL). Copy them with `npm run dev:env`. Nothing here is a production
# value: the server's settings live in sakke-workspace's .env, documented in
# its .env.example. Never put a real credential in this file.

# Ollama (main agent - tool calling, conversation). 172.31.0.1 is the Windows
# host as seen from WSL, where the dev PC's Ollama runs.
OLLAMA_BASE_URL=http://172.31.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q8_0
# OLLAMA_NUM_CTX=32768   # KV cache size - lower on VRAM-constrained deployments
# OLLAMA_THINK=false     # omit to use the model's own default

# Follow-up classifier (continuation/new_request/noise) - deliberately
# independent of the main agent's model/endpoint above, so it stays fast even
# if the main agent is routed to a bigger model. If it can't be reached, Sakke
# stops responding to follow-ups entirely (it fails quiet, by design).
OLLAMA_CLASSIFIER_BASE_URL=http://172.31.0.1:11434
OLLAMA_CLASSIFIER_MODEL=qwen3:4b-instruct-2507-q8_0

# Optional GPU-routing target (see scripts/gpu-router/ in sakke-workspace) -
# leave unset to always use the OLLAMA_* config above. When set, the main
# agent routes here instead, but only when /internal/gpu-status reports
# state=available; busy/unknown/stale always falls back to OLLAMA_* above.
# The "I'm gaming" / "I'm free" override asks the status service on this host
# (port 5055) to free Ollama's VRAM.
# PC_OLLAMA_BASE_URL=http://<pc-tailscale-ip>:11434
# PC_OLLAMA_MODEL=qwen3:14b
# PC_OLLAMA_NUM_CTX=32768
# PC_OLLAMA_THINK=false

# Home Assistant. With no token the gateway still starts and reports it; Home
# Assistant tools and spoken announcements fail. To hear announcements on the
# real satellite, point these at the real Home Assistant with your own token,
# in .env only.
HA_BASE_URL=http://localhost:8123
HA_TOKEN=
ASSIST_SATELLITE_ENTITY_ID=assist_satellite.sakke_assist_satellite

# Gateway
PORT=3100
# Where the tidiness coach keeps its state (and where an old timers.json is
# imported from). Relative to where the gateway is started, and git-ignored.
STATE_DIR=./data

# Gateway database: its own database on the local MariaDB, not the bot's.
# Created once with the SQL in README.md (Run locally). The password is a
# dev-only value that exists nowhere else. Leave GATEWAY_DB_HOST unset and the
# gateway still runs, with scheduling unavailable.
GATEWAY_DB_HOST=127.0.0.1
GATEWAY_DB_PORT=3306
GATEWAY_DB_NAME=sakke_gateway
GATEWAY_DB_USERNAME=sakke_gateway
GATEWAY_DB_PASSWORD=sakke-gateway-dev

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# How long to wait after waking the living room TV before sending it an app to
# launch. Tuned against one particular TV; lower it if yours is quicker.
TV_WAKE_MS=5000
