# Ollama (main agent - tool calling, conversation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=32768   # KV cache size - lower on VRAM-constrained deployments
# OLLAMA_THINK=false     # omit to use the model's own default

# Follow-up classifier (continuation/new_request/noise) - deliberately
# independent of the main agent's model/endpoint above, so it stays fast and
# local even if the main agent gets routed to a bigger/remote model.
# REQUIRED in a container deployment: the built-in defaults assume
# host.docker.internal, and if the classifier can't be reached Sakke stops
# responding to follow-ups entirely (it fails quiet, by design).
OLLAMA_CLASSIFIER_BASE_URL=http://host.docker.internal:11434
OLLAMA_CLASSIFIER_MODEL=qwen3:4b-instruct-2507-q8_0

# Optional GPU-routing target (see scripts/gpu-router/ in sakke-workspace) -
# leave unset to always use the OLLAMA_* config above. When set, the main
# agent routes here instead, but only when /internal/gpu-status reports
# state=available; busy/unknown/stale always falls back to OLLAMA_* above.
# PC_OLLAMA_BASE_URL=http://<pc-tailscale-ip>:11434
# PC_OLLAMA_MODEL=qwen3:14b
# PC_OLLAMA_NUM_CTX=32768
# PC_OLLAMA_THINK=false

# The "I'm gaming" / "I'm free" voice override derives the PC's host from
# PC_OLLAMA_BASE_URL and asks the status service there (port 5055) to free
# Ollama's VRAM via its POST /unload. The gateway owns the override decision;
# the PC only performs the local action. Commits 03fbd71 / 1a31d2c replaced the
# earlier version, which called the PC's Ollama API directly from here.

# Home Assistant
HA_BASE_URL=http://localhost:8123
HA_TOKEN=your_long_lived_access_token_here
HA_CONFIG_PATH=/ha-config
ASSIST_SATELLITE_ENTITY_ID=assist_satellite.sakke_assist_satellite

# Gateway
PORT=3100
# Where timers are persisted so they survive a redeploy. Must be a writable
# volume - see docker-compose.yml.
STATE_DIR=/data

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# How long to wait after waking the living room TV before sending it an app to
# launch. Tuned against one particular TV; lower it if yours is quicker.
TV_WAKE_MS=5000
