{
  // Build-only. The main tsconfig covers src/ and tests/ without a rootDir so
  // it can type-check both; this one narrows to src/, restores rootDir so dist/
  // isn't nested under a src/ folder, and drops the test files - they would
  // otherwise ship in the Docker image next to a vitest import that
  // `npm prune --omit=dev` has already removed.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
