{
  "name": "sakke-gateway",
  "version": "0.1.0",
  "description": "AI Gateway — parses natural language commands and dispatches to Home Assistant",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && find src -name '*.md' ! -name README.md -exec sh -c 'for f; do d=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$d\")\"; cp \"$f\" \"$d\"; done' _ {} +",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "dev:env": "sh scripts/dev-env.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests",
    "eval:classifier": "tsc -p tsconfig.json --outDir .eval-dist && node .eval-dist/scripts/eval-classifier.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.3.3",
    "js-logger": "^1.6.1",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.24.4",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
